"исходящий с gsm-телефона на общий номер компании с fmc и переадресация на gsm-телефон"

@startuml

skinparam backgroundcolor #f0f0f0
skinparam ParticipantPadding 20
skinparam BoxPadding 20
skinparam defaultFontName Fira Code
skinparam sequenceMessageAlign direction

hide footbox
!pragma teoz true

!$gsm1  = "#700"
!$gsm2  = "#B44"
!$gsm3  = "#F77"
!$gsm4  = "#c99"

!$sip1  = "#055"
!$sip2  = "#199"
!$sip3  = "#505"
!$sip4  = "#909"
!$sip5  = "#b0b"
!$sip6  = "#e0e"

!$rtp1   = "#050"
!$rtp2   = "#383"

!$aliceCallerNumber = "22 008 96 36"
!$aliceNumber = "996 22 008 96 36"
!$companyNumber = "996 22 008 90 78"
!$companyMSRN = "996 77 259 07 05"
!$bobNumber = "996 22 022 30 64"
!$bobMSRN = "996 77 259 23 20"

!$flowDescription = "Alice is PBX subscriber (with SIM +"+$aliceNumber+"), dialing from Alice's GSM phone number +"+$companyNumber+"\n\
Company number PBX subscriber (with SIM +"+$companyNumber+"). For Company MSC give MSRN: +"+$companyMSRN+"\n\
Bob is PBX subscriber (with SIM +"+$bobNumber+"). For Bob subscriber MSC give MSRN: +"+$bobMSRN+"\
"

!$sbc_ip = "91.192.65.180"
!$normal_port = "5060"
!$fmc_port = "5062"
!$fe_ip = "91.247.60.40"
!$mg_ip = "91.247.60.82"

actor "Alice\n(GSM)" as a

box "MVO"
    participant "MSC" as msc
    participant "SBC" as sbc
    participant "MGW" as mgw
end box

box "Example Platform"
    participant "FE" as fe
    participant "MG" as mg
end box

actor "Bob\n(PSTN)" as b


note over a, b: $flowDescription

group Initialize call from GSM-terminal (Alice)

a[$gsm1]->msc: Call $companyNumber
msc[$gsm1]->sbc: Call $companyNumber
sbc[$sip1]->fe: $sbc_ip:$normal_port → $fe_ip:$fmc_port\nINVITE sip:$companyNumber\nFrom: <sip:$aliceCallerNumber>
fe[$sip1]->sbc: 100 Trying

group Initialize outbound call to GSM-number (Company)

fe[$sip2]->sbc: $sbc_ip:$fmc_port ← $fe_ip:$fmc_port\nINVITE sip:$companyNumber\nFrom: <sip:$aliceCallerNumber>
sbc[$sip2]->fe: 100 Trying
sbc[$gsm1]->msc: Call $companyNumber
msc[$gsm1]->msc: Call $companyNumber

group Initialize inbound call to GSM-number (Company)

msc[$gsm2]->sbc: Call $companyNumber
sbc[$sip3]->fe: $sbc_ip:$normal_port → $fe_ip:$fmc_port\nINVITE sip:$companyMSRN\nFrom: <sip:$aliceCallerNumber>\nHistory-Info:<sip:$companyNumber>;index=1
fe[$sip3]->sbc: 100 Trying
fe[$sip1]->fe: Bind\n+$companyNumber\nwith\n+$companyMSRN

group Initialize outbound call to GSM-number (Bob)

fe[$sip4]->sbc: $sbc_ip:$fmc_port ← $fe_ip:$fmc_port\nINVITE sip:$bobNumber\nFrom: <sip:$aliceCallerNumber>
sbc[$sip4]->fe: 100 Trying
sbc[$gsm3]->msc: Call $bobNumber
msc[$gsm3]->msc: Call $bobNumber

group Initialize inbound call to GSM-number (Bob)

msc[$gsm4]->sbc: Call $bobNumber
sbc[$sip5]->fe: $sbc_ip:$normal_port → $fe_ip:$fmc_port\nINVITE sip:$bobMSRN\nFrom: <sip:$aliceCallerNumber>\nHistory-Info:<sip:$bobNumber>;index=1
fe[$sip5]->sbc: 100 Trying
fe[$sip1]->fe: Bind\n+$bobNumber\nwith\n+$bobMSRN

group Initialize call to GSM-terminal (Bob)

fe[$sip6]->sbc: $sbc_ip:$fmc_port ← $fe_ip:$fmc_port\nINVITE sip:$bobMSRN\nFrom: <sip:$aliceCallerNumber>\nDiversion: <sip:$bobNumber>
sbc[$sip6]->fe: 100 Trying
sbc[$gsm4]->msc: Call $bobNumber
msc[$gsm4]->b: Call $bobNumber

b[$gsm4]->msc: Ringing
msc[$gsm4]->sbc: Ringing
sbc[$sip6]->fe: 180 Ringing

end

fe[$sip5]->sbc: 180 Ringing
sbc[$gsm4]->msc: Ringing
msc[$gsm4]->msc: Ringing

end

msc[$gsm3]->sbc: Ringing
sbc[$sip4]->fe: 180 Ringing

end

fe[$sip3]->sbc: 180 Ringing
sbc[$gsm2]->msc: Ringing
msc[$gsm2]->msc: Ringing

end

msc[$gsm1]->sbc: Ringing
sbc[$sip2]->fe: 180 Ringing

end

fe[$sip1]->sbc: 180 Ringing
sbc[$gsm1]->msc: Ringing
msc[$gsm1]->a: Ringing

end

...
b[$gsm4]->msc: Answer
msc[$gsm4]->sbc: Answer
sbc[$sip6]->fe: 200 OK
fe[$sip6]->sbc: ACK
fe[$sip5]->sbc: 200 OK
sbc[$sip5]->fe: ACK

sbc[$gsm4]->msc: Answer
msc[$gsm4]->msc: Answer

msc[$gsm3]->sbc: Answer
sbc[$sip4]->fe: 200 OK
fe[$sip4]->sbc: ACK
fe[$sip3]->sbc: 200 OK
sbc[$sip3]->fe: ACK

sbc[$gsm3]->msc: Answer
msc[$gsm3]->msc: Answer

msc[$gsm2]->sbc: Answer
sbc[$sip2]->fe: 200 OK
fe[$sip2]->sbc: ACK
fe[$sip1]->sbc: 200 OK
sbc[$sip1]->fe: ACK

sbc[$gsm1]->msc: Answer
msc[$gsm1]->a: Answer


b<-[$rtp2]->mgw: Voice
mgw<-[$rtp2]->mg: RTP
a<-[$rtp1]->mgw: Voice
mgw<-[$rtp1]->mg: RTP
...

a[$gsm1]->msc: Bye
msc[$gsm1]->sbc: Bye
sbc[$sip1]->fe: BYE
fe[$sip1]->sbc: OK
fe[$sip2]->sbc: BYE
sbc[$sip2]->fe: OK

sbc[$gsm1]->msc: Bye
msc[$gsm1]->msc: Bye
msc[$gsm2]->sbc: Bye

sbc[$sip3]->fe: BYE
fe[$sip3]->sbc: OK
fe[$sip4]->sbc: BYE
sbc[$sip4]->fe: OK

sbc[$gsm2]->msc: Bye
msc[$gsm2]->msc: Bye
msc[$gsm3]->sbc: Bye

sbc[$sip5]->fe: BYE
fe[$sip5]->sbc: OK
fe[$sip6]->sbc: BYE
sbc[$sip6]->fe: OK
sbc[$gsm4]->msc: Bye
msc[$gsm4]->b: Bye

note over a, b: end-of-scenario

@enduml
